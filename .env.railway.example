# Paste these into Railway service variables.
# Do not commit real secret values.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# REQUIRED: long random secret used to sign JWT auth tokens (HS256).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-output-of-secrets-token_hex-32

# Use this only after adding a Railway volume mounted at /data.
DB_PATH=/data/quizzes.db

# Optional: needed for AI analysis in ENT attempt reviews and Telegram support replies.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Telegram support/admin bot.
TELEGRAM_BOT_TOKEN=1234567890:your_bot_token
TELEGRAM_ADMIN_IDS=123456789

# Optional: only needed for /api/quiz/dynamic/{city}.
# OPENAI_API_KEY=your_openai_api_key
