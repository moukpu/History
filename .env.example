# Copy this file to .env for local development.
DB_PATH=quizzes.db
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# REQUIRED IN PRODUCTION: secret used to sign JWT auth tokens (HS256).
# Use a strong random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# If unset, the server falls back to an ephemeral per-process secret which
# invalidates every existing token on restart -- only OK for local dev.
# JWT_SECRET=change-me-to-a-long-random-hex-string

# DEV_MODE=1 enables /api/dev/* endpoints AND the /dev-mobile/ launcher page
# (auto-login as dev.mobile.test@gmail.com + unlock all periods). Must be
# unset / 0 / false in production deploys.
# DEV_MODE=1

# Optional: needed for AI analysis in ENT attempt reviews and Telegram support replies.
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Telegram support/admin bot.
# Create a bot with @BotFather, then put your numeric Telegram user id here.
# TELEGRAM_BOT_TOKEN=1234567890:your_bot_token
# TELEGRAM_ADMIN_IDS=123456789

# Optional: only needed for /api/quiz/dynamic/{city}.
# OPENAI_API_KEY=your_openai_api_key
