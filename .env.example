# Copy this file to .env for local development.
DB_PATH=quizzes.db
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional: needed for AI analysis in ENT attempt reviews.
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Telegram admin bot.
# Create a bot with @BotFather, then put your numeric Telegram user id here.
# TELEGRAM_BOT_TOKEN=1234567890:your_bot_token
# TELEGRAM_ADMIN_IDS=123456789

# Optional: only needed for /api/quiz/dynamic/{city}.
# OPENAI_API_KEY=your_openai_api_key
